# Server Port (Cloud host defaults to process.env.PORT)
PORT=5000

# MongoDB Atlas Connection String or Local MongoDB URI
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/realtime_chat_db?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# JWT Secret Key for Signing Authentication Tokens
JWT_SECRET=your_secure_random_jwt_secret

# Production Allowed Frontend Client Domain for CORS
CLIENT_URL=https://your-frontend-domain.com

# Cloudinary Storage Credentials for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OTP Provider Configuration ('mock' for dev, 'twilio' for real production SMS)
OTP_PROVIDER=mock

# Twilio SMS Production Credentials (Required when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Environment Mode ('development' or 'production')
NODE_ENV=production

