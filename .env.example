# ==========================================
# Raabta - Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Service Configuration (backend/.env)
# ------------------------------------------
# Server Port (Defaults to 5000 in local dev)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/realtime_chat_db?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# JWT Secret Key for Signing Authentication Tokens
JWT_SECRET=your_secure_random_jwt_secret_key_min_32_chars

# Allowed Frontend Client Origin for CORS Isolation
CLIENT_URL=http://localhost:5173

# Cloudinary Credentials for Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OTP Service Provider Configuration ('mock' | 'twilio')
OTP_PROVIDER=mock

# Twilio SMS Credentials (Optional for Production SMS Delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Node Environment Mode ('development' | 'production')
NODE_ENV=development

# ------------------------------------------
# Frontend Client Configuration (frontend/.env)
# ------------------------------------------
# Backend REST API Base URL
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO Connection URL
VITE_SOCKET_URL=http://localhost:5000
